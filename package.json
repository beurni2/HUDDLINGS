{
  "name": "huddlings",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=dot \"runtime-web/test/*.test.ts\" \"characters/build/test/*.test.ts\"",
    "vectors": "node characters/format/make-vectors.ts",
