    "render": "node runtime-web/lab/render.ts",
    "render:all": "node runtime-web/lab/render-all.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "esbuild": "0.28.2",
    "playwright": "1.56.1",
    "pngjs": "7.0.0",
    "typescript": "6.0.3"
  }
}
