 "presets": {
  "neutral": {
   "primary": "master.expression.happy",
   "beside": [
    "expressions.expression.happy"
   ],
   "note": "Happy (default): the master sheet's Happy is the primary, less rolled than the expression sheet's (9.7 against 11.8 degrees) and on the sheet that ranks first. Idle is the motion sheet's Idle / breathing, not an expression panel, so it is compared by phase 4's Poses check. Both Happy panels draw an open mouth and neutral's is the smile: their eyes are held, their mouths reported."
  },
  "happy": {
   "primary": "master.expression.happy",
   "beside": [
    "expressions.expression.happy"
   ],
   "note": "The master sheet's Happy, for the reasons neutral gives; the expression sheet's beside it."
  },
  "excited": {
   "primary": "master.expression.excited",
   "beside": [
    "expressions.expression.excited"
   ],
   "note": "The master sheet's Excited (11.7 degrees of roll against the expression sheet's 12.1); the expression sheet's beside it. Its mouth's corners lie within 0.5 pt of Laughing's and its outline overlaps Laughing's at IoU 0.76: see laughing."
  },
  "laughing": {
   "primary": "master.expression.laughing",
   "beside": [
    "expressions.expression.laughing"
   ],
   "note": "The master sheet's Laughing (11.9 degrees against the expression sheet's 20.0). The master sheet draws Laughing's mouth no wider than Excited's: the corners within 0.5 pt, the open part 1.25 times as large, less than Happy's and Excited's open mouths differ (1.27 times). No gate tells laugh from open there without failing happy against excited, so excited and laughing legitimately match on the master sheet; the open part's difference is reported, and judged by eye."
  },
  "curious": {
   "primary": "master.expression.curious",
   "beside": [
    "expressions.expression.curious"
   ],
   "note": "The master sheet's Curious: both Curious panels tilt the head about 21 degrees and turn it toward the sheet's left (the eyes' middle 5.1 and 4.1 pt across from where the front puts it), so the sheet that ranks first decides. Turned: its open eyes are held by their shapes and spacing, and on the head. Its mouth, like the expression sheet's, is downturned (see _r3), judged by eye. Every panel that draws open eyes as far apart passes there (Happy, Surprised, Shy), so curious and shy legitimately match on what is held; their gaze, ears, blush and mouths are judged by eye."
  },
  "surprised": {
   "primary": "expressions.expression.surprised",
   "beside": [
    "master.expression.surprised"
   ],
   "note": "The expression sheet's Surprised: the only level Surprised (2.8 degrees of roll against the master sheet's 13.1), the master sheet's beside it. The sheets draw the wide eye as the open eye with a ring of white round its iris (expressions.eyes.surprised-round): its dark mark, which the check compares, measures as the open eye's (areas within 1.16 times, IoU 0.78 to 0.91), so a surprised face passes the eyes neutral holds; the mouth (o) is what differs."
  },
  "shy": {
   "primary": "expressions.expression.shy",
   "beside": [],
   "note": "The expression sheet's Shy, the only Shy panel. Its mouth is a small ∩, and shy's is a smile: its eyes are held, its mouth judged by eye. The head is turned toward the sheet's left (the eyes' middle 4.4 pt across from where the front puts it): its eyes are held by their shapes and spacing, and on the head. The far ear hangs across the right cheek, so its width is its sheet's median."
  },
  "proud": {
   "primary": "master.expression.content",
   "beside": [
    "expressions.expression.proud"
   ],
   "note": "The master sheet's Content is the primary: it draws proud's states (happy crescents and a smile) on a level head. The Proud panel raises the chin (its crescents 3.9 pt above the nose against Content's 6.8 and the turnaround's open eyes' 8.1), and a face preset keeps the front's head, so it is shown beside, with its stars for the sparkle (Q2). The still shows the sparkle: the happy crescents, held on Content, with the stars beside the head."
  },
  "mischievous": {
   "primary": "master.expression.cheeky",
   "beside": [
    "master.expression.winking",
    "expressions.expression.mischievous"
   ],
   "note": "The master sheet's Cheeky draws the wink with the cheeky mouth (the dog's left eye closed, the tongue out) on a nearly level head (6.6 degrees): the primary. Winking (the same wink with a smile) and the expression sheet's Mischievous, whose head is turned halfway to three-quarter and which winks the dog's right eye, are beside it. The face library winks the left eye, as Cheeky draws it. An open mouth passes Cheeky's mouth rows: the expression sheet's Mischievous draws its cheeky mouth open with the tongue in it, as Happy draws the open mouth, and only the deep-red share of the open part (Cheeky 0.14; the master sheet's open and laughing mouths 0.35 to 0.40; the expression sheet's Mischievous 0.27) tells Cheeky's tongue out from it, reported and judged by eye (docs/QUESTIONS.md Q27)."
  },
  "content": {
   "primary": "master.expression.content",
   "beside": [],
   "note": "The master sheet's Content (both eyes closed in happy arcs, a small smile, level)."
  },
  "sleepy": {
   "primary": "master.expression.sleepy",
   "beside": [
    "expressions.expression.sleepy"
   ],
   "note": "The master sheet's Sleepy (lying, chin on its paws, eyes closed; 8.8 degrees against the expression sheet's 9.5), the expression sheet's beside it: sleepy's 'then closed' eyes are held, so its still shows the closed eyes. No level panel draws closed eyes, and both Sleepy panels turn the head (the eyes' middle 3.0 pt across from where the front puts it): the closed arcs are held by their shapes and spacing, and on the head. Both mouths are downturned (see _r3), judged by eye. Not the expression sheet's Sleepy face assembly, whose label pairs it with drooped ears (R3)."
  },
  "listening": {
   "primary": "expressions.ears.lifted-slightly",
   "beside": [],
   "note": "Lifted slightly is the dog's lifted ears (Forward and Perked are the other species' names). It draws a head with no face, so no anchor is held: the record places the render beside it, on the head's top, for the eyes of the agent and the founder; the face is still held to its head."
  },
  "tender": {
   "primary": "master.expression.content",
   "beside": [],
   "note": "The master sheet's Content (L493). Tender's eyes are the sleepy half-lid, which Content does not draw: its smile is held, its eyes reported, and held on the head by the eye parts' own pixels, which a lid closing over the eye does not move."
  },
  "singing": {
   "primary": "master.expression.laughing",
   "beside": [
    "master.expression.happy",
    "expressions.expression.laughing",
    "expressions.expression.happy"
   ],
   "note": "The master sheet's Laughing: its crescents are singing's happy eyes and are held, so its still shows the crescents, not the closed eyes; its open mouth is not singing's o and is reported. Happy (both sheets) and the expression sheet's Laughing are beside it."
  },
  "blissful": {
   "primary": "master.expression.content",
   "beside": [],
   "note": "The master sheet's Content (L495): its crescents (blissful's 'then happy') and its smile are held, so its still shows the crescents, not the closed eyes."
  },
  "ticklish": {
   "primary": "master.expression.laughing",
   "beside": [
    "master.expression.excited",
    "expressions.expression.laughing",
    "expressions.expression.excited"
   ],
   "note": "The master sheet's Laughing holds ticklish's laughing mouth. Its eyes are the squeeze, the dog's own > < drawn as the kitty's and the bear's Excited draw theirs (docs/QUESTIONS.md Q2, the founder's choice of Oct 16, 2026; DECISIONS.md 200, 202, 206): no panel of the dog's sheets draws them, so they are judged by eye beside those two panels (qa/phase3/faces/eyes.png) and held on the face's head only, and this record lists no eye state for the check to hold (listed as squeeze, the aliases' Q2 default would hold them to Laughing's crescents, which they are not). Excited (both sheets) and the expression sheet's Laughing are beside it."
  },
  "hungry": {
   "primary": null,
   "beside": [],
   "note": "A new drawing the founder approves (L497, R3); no panel."
  },
  "huffy": {
   "primary": null,
   "beside": [],
   "note": "A new drawing the founder approves (L498, R3); never the sheets' Angry or Pout; no panel."
  },
  "sly": {
   "primary": "master.expression.cheeky",
   "beside": [
    "master.expression.winking",
    "expressions.expression.mischievous"
   ],
   "note": "The master sheet's Cheeky, as mischievous; Winking and the expression sheet's Mischievous beside it."
  }
 }
