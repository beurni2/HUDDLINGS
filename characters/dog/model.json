 "markings": [
  {
   "id": "head.patch.L",
   "part": "head.base",
   "side": "L",
   "note": "Tan around the dog's left eye and down behind its outer side, rising into the left ear's root, which hides its upper edge. Painted a paler tan than the body's patches (DECISIONS 18, Q24). Shown wherever the left eye shows."
  },
  {
   "id": "head.patch.R",
   "part": "head.base",
   "side": "R",
   "note": "The mirror of head.patch.L around the right eye, as the front turnaround and the hero draw it."
  },
  {
   "id": "back.patch.L",
   "part": "body.back",
   "side": "L",
   "note": "The left half of a saddle over the back, just behind the collar: from the spine down the left side to the top of the haunch. From behind it is the larger half, reaching down to the tail's root (the back turnaround); on the left side it sits high on the back (side and three-quarter turnarounds, the motion sheet's Stand)."
  },
  {
   "id": "back.patch.R",
   "part": "body.back",
   "side": "R",
   "note": "The right half of the saddle: from the spine just behind the collar, where the back turnaround shows it crossing over, down the right flank toward the haunch, reaching lower than the left half (the front turnaround, the hero). In the motion sheet's right-side poses it reaches the topline at the rump. Sitting, the saddle runs down the sloping back to the haunch; standing, it lies along the level topline to the rump."
  },
  {
   "id": "tail.base",
   "part": "tail",
   "side": "both",
   "note": "Tan at the root of the tail; the curl stays cream."
  },
  {
   "id": "rump.patch.L",
   "part": "body.back",
   "side": "L",
   "note": "A small soft spot on the rump at the tail's root, where the tail's tan crosses the body's outline, fading paler away from the outline (the side and three-quarter turnarounds). No right-side panel shows one."
  }
 ],
